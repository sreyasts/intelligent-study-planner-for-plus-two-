{
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "cleanUrls": false,
    "rewrites": [
      {
        "source": "/pages/terms",
        "destination": "/pages/terms.html"
      },
      {
        "source": "/pages/privacy",
        "destination": "/pages/privacy.html"
      },
      {
        "source": "/pages/syllabus-plus-two",
        "destination": "/pages/syllabus-plus-two.html"
      },
      {
        "source": "/pages/plus-one-improvement-guide",
        "destination": "/pages/plus-one-improvement-guide.html"
      }
    ],
    "headers": [
      {
        "source": "sw.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "**/*.@(js|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
